# Rust build output. The aarch64 and per-runner target directories are kept
# separate from the host build so a cross build cannot poison it.
/target
/target-*/
/target-aarch64

# Cargo-fuzz build output and generated corpora. Seeds are regenerated by
# `cargo test --manifest-path fuzz/Cargo.toml --test seeds`.
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage

# Coverage runs (llvm-cov and friends) leave these at the repo root.
*.profraw
*.profdata
/coverage

# Local-only notes and research. These live in a separate checkout so they
# cannot be published by accident. `*.local.md` is the one rule to remember.
*.local.md
*.local.toml
/research/
LOCAL-NOTES.md

# Agent and editor state, plus throwaway test output.
/.claude/
/.agent/
/.agents/
/.codex/
/.cursor/
/.idea/
/.vscode/
__pycache__/
*.pyc
*.swp
*.swo
*.orig
*.rej
*.tmp
*.bak
*.log
.DS_Store

# Local environment files. An example file may be committed.
.env
.env.*
!.env.example

# Design sources and generated previews. The OpenPencil tree is deliberately
# outside this repository, and these rules keep a local copy from sneaking in.
/design/
*.opdesign
*.pen
/screenshots/
/*-screenshot.png
